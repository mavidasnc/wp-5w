{
    "name": "mavida/wp-5w",
    "description": "Dashboard di analytics in wp-admin che incrocia i dati di WP Statistics e Rank Math (Search Console).",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Mavida snc",
            "homepage": "https://mavida.it",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.3",
        "composer/installers": "^2.2",
        "maxmind-db/reader": "^1.14",
        "yahnis-elsts/plugin-update-checker": "^5.4"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^10.5",
        "php-stubs/wordpress-stubs": "^6.5",
        "php-stubs/wp-cli-stubs": "^2.10",
        "squizlabs/php_codesniffer": "^3.10",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "Mavida\\FiveW\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mavida\\FiveW\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyze": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "ci": [
            "@lint",
            "@analyze",
            "@test"
        ]
    }
}
